   6          #include "Debug.H"
   7          
   8          void CfgFsys(void)  
   9          {
  10   1          SAFE_MOD = 0x55;
  11   1          SAFE_MOD = 0xAA;
  12   1          // Khóa xung nh?p Fsys = 24MHz (Fusb4x = 48MHz dành riêng cho b? SIE USB)
  13   1          CLOCK_CFG = (CLOCK_CFG & ~MASK_SYS_CK_SEL) | 0x05; 
  14   1          SAFE_MOD = 0x00;
  15   1      }
  16          
  17          void mDelayuS(UINT16 n)  
  18          {
  19   1          while(n) {
  20   2              ++SAFE_MOD;
  21   2              ++SAFE_MOD;
  22   2              --n;
  23   2          }
  24   1      }
  25          
  26          void mDelaymS(UINT16 n)                                                    
  27          {
  28   1          while(n) {
  29   2              mDelayuS(1000);
  30   2              --n;
  31   2          }
  32   1      }


